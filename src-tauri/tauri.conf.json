{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trackfecta",
  "version": "1.0.0",
  "identifier": "com.trackfecta.app",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trackfecta",
        "width": 480,
        "height": 620,
        "minWidth": 400,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      }
    },
    "shortDescription": "Unofficial Toggl Track desktop client",
    "longDescription": "Trackfecta is a beautiful, but unofficial, tray-first desktop client for Toggl Track on Linux. Not affiliated with Toggl.",
    "license": "MIT",
    "homepage": "https://github.com/JayCodist/trackfecta",
    "category": "Productivity"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQkJGRTc2N0YxRjJENDEKUldSQkxSOS9kdjY3Yld3cTRaSWIrSVlPSlFrdHgwV2kyMkRJWUpVQytHQ1hzUXdyRHQwekZ5b2sK",
      "endpoints": [
        "https://github.com/JayCodist/trackfecta/releases/latest/download/latest.json"
      ]
    }
  }
}
