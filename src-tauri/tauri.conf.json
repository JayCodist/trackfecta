{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trackfecta",
  "version": "1.0.4",
  "identifier": "io.github.jaycodist.trackfecta",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trackfecta",
        "width": 480,
        "height": 620,
        "minWidth": 400,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"],
        "desktopTemplate": "desktop-template.hbs",
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/trackfecta.svg": "icons/trackfecta-logo.svg",
          "/usr/share/icons/hicolor/16x16/apps/trackfecta.png": "icons/hicolor/trackfecta-16.png",
          "/usr/share/icons/hicolor/22x22/apps/trackfecta.png": "icons/hicolor/trackfecta-22.png",
          "/usr/share/icons/hicolor/24x24/apps/trackfecta.png": "icons/hicolor/trackfecta-24.png",
          "/usr/share/icons/hicolor/32x32/apps/trackfecta.png": "icons/hicolor/trackfecta-32.png",
          "/usr/share/icons/hicolor/48x48/apps/trackfecta.png": "icons/hicolor/trackfecta-48.png",
          "/usr/share/icons/hicolor/64x64/apps/trackfecta.png": "icons/hicolor/trackfecta-64.png",
          "/usr/share/icons/hicolor/96x96/apps/trackfecta.png": "icons/hicolor/trackfecta-96.png",
          "/usr/share/icons/hicolor/128x128/apps/trackfecta.png": "icons/hicolor/trackfecta-128.png",
          "/usr/share/icons/hicolor/192x192/apps/trackfecta.png": "icons/hicolor/trackfecta-192.png",
          "/usr/share/icons/hicolor/256x256/apps/trackfecta.png": "icons/hicolor/trackfecta-256.png",
          "/usr/share/icons/hicolor/256x256@2/apps/trackfecta.png": "icons/hicolor/trackfecta-512.png",
          "/usr/share/icons/hicolor/512x512/apps/trackfecta.png": "icons/hicolor/trackfecta-512.png"
        }
      },
      "rpm": {
        "desktopTemplate": "desktop-template.hbs",
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/trackfecta.svg": "icons/trackfecta-logo.svg",
          "/usr/share/icons/hicolor/16x16/apps/trackfecta.png": "icons/hicolor/trackfecta-16.png",
          "/usr/share/icons/hicolor/22x22/apps/trackfecta.png": "icons/hicolor/trackfecta-22.png",
          "/usr/share/icons/hicolor/24x24/apps/trackfecta.png": "icons/hicolor/trackfecta-24.png",
          "/usr/share/icons/hicolor/32x32/apps/trackfecta.png": "icons/hicolor/trackfecta-32.png",
          "/usr/share/icons/hicolor/48x48/apps/trackfecta.png": "icons/hicolor/trackfecta-48.png",
          "/usr/share/icons/hicolor/64x64/apps/trackfecta.png": "icons/hicolor/trackfecta-64.png",
          "/usr/share/icons/hicolor/96x96/apps/trackfecta.png": "icons/hicolor/trackfecta-96.png",
          "/usr/share/icons/hicolor/128x128/apps/trackfecta.png": "icons/hicolor/trackfecta-128.png",
          "/usr/share/icons/hicolor/192x192/apps/trackfecta.png": "icons/hicolor/trackfecta-192.png",
          "/usr/share/icons/hicolor/256x256/apps/trackfecta.png": "icons/hicolor/trackfecta-256.png",
          "/usr/share/icons/hicolor/256x256@2/apps/trackfecta.png": "icons/hicolor/trackfecta-512.png",
          "/usr/share/icons/hicolor/512x512/apps/trackfecta.png": "icons/hicolor/trackfecta-512.png"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/trackfecta.svg": "icons/trackfecta-logo.svg",
          "/usr/share/icons/hicolor/16x16/apps/trackfecta.png": "icons/hicolor/trackfecta-16.png",
          "/usr/share/icons/hicolor/22x22/apps/trackfecta.png": "icons/hicolor/trackfecta-22.png",
          "/usr/share/icons/hicolor/24x24/apps/trackfecta.png": "icons/hicolor/trackfecta-24.png",
          "/usr/share/icons/hicolor/32x32/apps/trackfecta.png": "icons/hicolor/trackfecta-32.png",
          "/usr/share/icons/hicolor/48x48/apps/trackfecta.png": "icons/hicolor/trackfecta-48.png",
          "/usr/share/icons/hicolor/64x64/apps/trackfecta.png": "icons/hicolor/trackfecta-64.png",
          "/usr/share/icons/hicolor/96x96/apps/trackfecta.png": "icons/hicolor/trackfecta-96.png",
          "/usr/share/icons/hicolor/128x128/apps/trackfecta.png": "icons/hicolor/trackfecta-128.png",
          "/usr/share/icons/hicolor/192x192/apps/trackfecta.png": "icons/hicolor/trackfecta-192.png",
          "/usr/share/icons/hicolor/256x256/apps/trackfecta.png": "icons/hicolor/trackfecta-256.png",
          "/usr/share/icons/hicolor/256x256@2/apps/trackfecta.png": "icons/hicolor/trackfecta-512.png",
